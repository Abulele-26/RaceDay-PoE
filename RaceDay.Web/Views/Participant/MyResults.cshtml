@model IEnumerable<RaceDay.Web.DTOs.ResultDto>

@{
    ViewData["Title"] = "My Results";
}

<h2>My Race History</h2>
<table class="table table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Event</th>
            <th>Category</th>
            <th>Finish Time</th>
            <th>Position</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No results found yet. Keep running!</td></tr>
        }
        @foreach (var res in Model)
        {
            <tr>
                <td>@res.EventName</td>
                <td>@res.CategoryName</td>
                <td>@res.FinishTime</td>
                <td><strong>@res.Position</strong></td>
            </tr>
        }
    </tbody>
</table>