@model RaceDay.Web.DTOs.EventDto

@{
    ViewData["Title"] = Model.Name;
    var categories = ViewBag.Categories as List<RaceDay.Web.DTOs.CategoryDto>;
}

<div class="card shadow mb-4">
    <div class="card-header bg-dark text-white">
        <h2>@Model.Name</h2>
    </div>
    <div class="card-body">
        <h5 class="card-title">@Model.Location | @Model.EventDate.ToString("dd MMM yyyy")</h5>
        <p class="card-text">@Model.Description</p>
        <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item"><strong>Distance:</strong> @Model.Distance km</li>
            <li class="list-group-item"><strong>Type:</strong> @Model.EventType</li>
        </ul>

        <h4>Enrol Now</h4>
        <form asp-action="Enroll" method="post" class="row g-3">
            <input type="hidden" name="eventId" value="@Model.EventId" />
            <div class="col-md-8">
                <select name="categoryId" class="form-select" required>
                    <option value="">-- Select a Category --</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-success w-100">Enrol</button>
            </div>
        </form>
    </div>
</div>
<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Events</a>