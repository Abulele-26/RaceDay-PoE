@model IEnumerable<RaceDay.Web.DTOs.EventDto>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Manage Events</h2>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="fw-bold">@ev.Name</td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.EventType</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-primary">Edit</a>
                                <a asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-info text-white">Categories</a>
                                <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-secondary">Enrolments</a>
                                <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-warning">Results</a>

                                <!-- Delete Form with Confirmation -->
                                <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger rounded-0 rounded-end">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>